{
  "openapi": "3.1.0",
  "info": {
    "title": "eduapp Public API",
    "version": "0.1.0",
    "description": "قرارداد نسخه آغازین پلتفرم چندمستأجری مدیریت آموزشی. نمایش endpoint در Swagger به معنای مجوز اجرا نیست. سرویس‌های backend به‌تدریج طبق roadmap پیاده‌سازی می‌شوند."
  },
  "servers": [{"url": "https://srun.ir/eduapp/api/v1", "description": "Production base path"}],
  "tags": [
    {"name":"System"},{"name":"Authentication"},{"name":"Access"},{"name":"Tenants"},{"name":"Users"},{"name":"Custom Fields"},{"name":"Billing"},{"name":"Assets"},{"name":"Sites"},{"name":"Schools"},{"name":"Enrollment"},{"name":"Attendance"},{"name":"Notifications"},{"name":"Integrations"}
  ],
  "paths": {
    "/health/live": {"get":{"tags":["System"],"summary":"Liveness probe","operationId":"getLiveness","security":[],"responses":{"200":{"description":"Process is alive","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Health"}}}}}}},
    "/health/ready": {"get":{"tags":["System"],"summary":"Readiness probe","operationId":"getReadiness","security":[],"responses":{"200":{"description":"Dependencies are ready","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Health"}}}},"503":{"$ref":"#/components/responses/ServiceUnavailable"}}}},
    "/version": {"get":{"tags":["System"],"summary":"Build version","operationId":"getVersion","security":[],"responses":{"200":{"description":"Version metadata"}}}},
    "/auth/login": {"post":{"tags":["Authentication"],"summary":"Password login","operationId":"login","security":[],"requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"200":{"description":"Authenticated session"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/TooManyRequests"}}}},
    "/auth/otp/request": {"post":{"tags":["Authentication"],"summary":"Request OTP challenge","operationId":"requestOtp","security":[],"requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"202":{"description":"Challenge accepted"},"429":{"$ref":"#/components/responses/TooManyRequests"}}}},
    "/auth/otp/verify": {"post":{"tags":["Authentication"],"summary":"Verify OTP","operationId":"verifyOtp","security":[],"requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"200":{"description":"Authenticated session"},"422":{"$ref":"#/components/responses/ValidationError"}}}},
    "/auth/refresh": {"post":{"tags":["Authentication"],"summary":"Rotate refresh session","operationId":"refreshSession","security":[],"responses":{"200":{"description":"Rotated session"},"401":{"$ref":"#/components/responses/Unauthorized"}}}},
    "/auth/logout": {"post":{"tags":["Authentication"],"summary":"Revoke current session","operationId":"logout","responses":{"204":{"description":"Session revoked"}}}},
    "/auth/mfa/enroll": {"post":{"tags":["Authentication"],"summary":"Begin second-factor enrollment","operationId":"beginMfaEnrollment","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"401":{"$ref":"#/components/responses/Unauthorized"},"422":{"$ref":"#/components/responses/ValidationError"},"429":{"$ref":"#/components/responses/TooManyRequests"},"503":{"$ref":"#/components/responses/ServiceUnavailable"}}}},
    "/auth/mfa/enroll/confirm": {"post":{"tags":["Authentication"],"summary":"Confirm second-factor enrollment","operationId":"confirmMfaEnrollment","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"401":{"$ref":"#/components/responses/Unauthorized"},"422":{"$ref":"#/components/responses/ValidationError"},"429":{"$ref":"#/components/responses/TooManyRequests"},"503":{"$ref":"#/components/responses/ServiceUnavailable"}}}},
    "/auth/mfa/step-up": {"post":{"tags":["Authentication"],"summary":"Verify the second factor for sensitive actions","operationId":"verifyMfaStepUp","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"401":{"$ref":"#/components/responses/Unauthorized"},"422":{"$ref":"#/components/responses/ValidationError"},"429":{"$ref":"#/components/responses/TooManyRequests"},"503":{"$ref":"#/components/responses/ServiceUnavailable"}}}},
    "/auth/mfa/recovery": {"post":{"tags":["Authentication"],"summary":"Begin recovery of the second factor","operationId":"requestMfaRecovery","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"401":{"$ref":"#/components/responses/Unauthorized"},"422":{"$ref":"#/components/responses/ValidationError"},"429":{"$ref":"#/components/responses/TooManyRequests"},"503":{"$ref":"#/components/responses/ServiceUnavailable"}}}},
    "/auth/mfa/recovery/confirm": {"post":{"tags":["Authentication"],"summary":"Confirm a replacement second factor","operationId":"confirmMfaRecovery","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"401":{"$ref":"#/components/responses/Unauthorized"},"422":{"$ref":"#/components/responses/ValidationError"},"429":{"$ref":"#/components/responses/TooManyRequests"},"503":{"$ref":"#/components/responses/ServiceUnavailable"}}}},
    "/me/sessions": {"get":{"tags":["Authentication"],"summary":"List active sessions","operationId":"listMySessions","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}}},
    "/me/capabilities": {"get":{"tags":["Access"],"summary":"Resolve scoped permissions and entitlements","operationId":"getMyCapabilities","responses":{"200":{"$ref":"#/components/responses/ListResponse"},"403":{"$ref":"#/components/responses/Forbidden"}}}},
    "/roles": {"get":{"tags":["Access"],"summary":"List scoped roles","operationId":"listRoles","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Access"],"summary":"Create versioned custom role","operationId":"createRole","description":"Requires role management permission and recent MFA for the current membership.","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"403":{"$ref":"#/components/responses/Forbidden"},"422":{"$ref":"#/components/responses/ValidationError"}}}},
    "/roles/{roleId}": {"patch":{"tags":["Access"],"summary":"Create a new role revision","operationId":"updateRole","description":"Requires role management permission and recent MFA for the current membership.","parameters":[{"$ref":"#/components/parameters/RoleId"}],"requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/role-assignments": {"post":{"tags":["Access"],"summary":"Assign role within scope","operationId":"assignRole","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"403":{"$ref":"#/components/responses/Forbidden"}}}},
    "/tenants": {
      "get":{"tags":["Tenants"],"summary":"List the authorized selected tenant","operationId":"listTenants","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},
      "post":{"tags":["Tenants"],"summary":"Provision a tenant and its first owner","operationId":"createTenant","description":"Requires a verified provisioning authorization and Idempotency-Key. Body: slug, displayName, ownerIdentityId, legalEntity with name/countryCode/registrationNumber, and optional trialDays.","parameters":[{"name":"Idempotency-Key","in":"header","description":"Required by the provisioner. Reuse with the same request to replay.","schema":{"type":"string","minLength":8,"maxLength":128}}],"requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"},"422":{"$ref":"#/components/responses/ValidationError"}}}
    },
    "/tenants/{tenantId}": {"get":{"tags":["Tenants"],"summary":"Get the selected tenant","operationId":"getTenant","parameters":[{"$ref":"#/components/parameters/TenantId"}],"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"404":{"$ref":"#/components/responses/NotFound"}}}},
    "/tenants/{tenantId}/status": {"patch":{"tags":["Tenants"],"summary":"Suspend or reactivate a tenant","operationId":"updateTenantStatus","description":"Requires separate platform authorization. The status and expectedVersion are required.","parameters":[{"$ref":"#/components/parameters/TenantId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["status","expectedVersion"],"additionalProperties":false,"properties":{"status":{"type":"string","enum":["active","suspended"]},"expectedVersion":{"type":"integer","minimum":1}}}}}},"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"412":{"description":"Tenant version changed"},"422":{"$ref":"#/components/responses/ValidationError"}}}},
    "/org-units": {
      "get":{"tags":["Tenants"],"summary":"List organization units in the selected tenant","operationId":"listOrgUnits","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},
      "post":{"tags":["Tenants"],"summary":"Create an organization unit","operationId":"createOrgUnit","description":"Body: kind, code, name, idempotencyKey and optional parentId. Kinds: holding, company, collection, branch, school, institute.","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Conflict"},"422":{"$ref":"#/components/responses/ValidationError"}}}
    },
    "/org-units/tree": {"get":{"tags":["Tenants"],"summary":"Page through the organization tree","operationId":"getOrgTree","description":"Each item includes orgUnitId, parentId, kind, code, name and version. Assemble the tree using parentId.","parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100}},{"name":"cursor","in":"query","schema":{"type":"string"}}],"responses":{"200":{"$ref":"#/components/responses/ListResponse"}}}},
    "/org-units/{orgUnitId}/move": {"post":{"tags":["Tenants"],"summary":"Move an organization unit","operationId":"moveOrgUnit","description":"Send the current version in If-Match and the new parentId in the body. Use null parentId for a permitted root kind.","parameters":[{"$ref":"#/components/parameters/OrgUnitId"},{"name":"If-Match","in":"header","description":"Required current ETag, for example \"1\".","schema":{"type":"string"}}],"requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Conflict"},"412":{"description":"Organization unit version changed"},"428":{"description":"If-Match is required"}}}},
    "/users": {"get":{"tags":["Users"],"summary":"List users in scope","operationId":"listUsers","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Users"],"summary":"Create user profile","operationId":"createUser","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"}}}},
    "/users/{userId}": {"get":{"tags":["Users"],"summary":"Get masked user profile","operationId":"getUser","parameters":[{"$ref":"#/components/parameters/UserId"}],"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"404":{"$ref":"#/components/responses/NotFound"}}}},
    "/memberships": {"post":{"tags":["Users"],"summary":"Create scoped membership","operationId":"createMembership","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"403":{"$ref":"#/components/responses/Forbidden"}}}},
    "/invitations": {"post":{"tags":["Users"],"summary":"Invite member","operationId":"createInvitation","description":"Requires invitation permission and recent MFA for the current membership.","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"202":{"description":"Invitation queued"},"403":{"$ref":"#/components/responses/Forbidden"}}}},
    "/field-definitions": {"get":{"tags":["Custom Fields"],"summary":"List field schemas","operationId":"listFieldDefinitions","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Custom Fields"],"summary":"Create versioned field schema","operationId":"createFieldDefinition","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"422":{"$ref":"#/components/responses/ValidationError"}}}},
    "/plans": {"get":{"tags":["Billing"],"summary":"List purchasable plan versions","operationId":"listPlans","security":[],"responses":{"200":{"$ref":"#/components/responses/ListResponse"}}}},
    "/subscriptions/checkout": {"post":{"tags":["Billing"],"summary":"Create subscription checkout","operationId":"createCheckout","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/subscriptions/{subscriptionId}": {"get":{"tags":["Billing"],"summary":"Get subscription","operationId":"getSubscription","parameters":[{"$ref":"#/components/parameters/SubscriptionId"}],"responses":{"200":{"$ref":"#/components/responses/ItemResponse"}}}},
    "/invoices/{invoiceId}/payment-attempts": {"post":{"tags":["Billing"],"summary":"Start payment attempt","operationId":"createPaymentAttempt","parameters":[{"$ref":"#/components/parameters/InvoiceId"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"202":{"description":"Payment attempt created"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/webhooks/payments/{provider}": {"post":{"tags":["Billing"],"summary":"Receive verified provider callback","operationId":"receivePaymentWebhook","security":[],"parameters":[{"name":"provider","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Accepted or deduplicated"},"401":{"$ref":"#/components/responses/Unauthorized"}}}},
    "/assets/upload-sessions": {"post":{"tags":["Assets"],"summary":"Create secure upload session","operationId":"createUploadSession","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"413":{"description":"Quota or size exceeded"}}}},
    "/assets/upload-sessions/{uploadSessionId}/complete": {"post":{"tags":["Assets"],"summary":"Verify and complete upload","operationId":"completeUpload","parameters":[{"name":"uploadSessionId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"422":{"$ref":"#/components/responses/ValidationError"}}}},
    "/assets/{assetId}/download-url": {"get":{"tags":["Assets"],"summary":"Issue scoped short-lived download URL","operationId":"getAssetDownloadUrl","parameters":[{"name":"assetId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"403":{"$ref":"#/components/responses/Forbidden"}}}},
    "/sites": {"get":{"tags":["Sites"],"summary":"List sites in scope","operationId":"listSites","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Sites"],"summary":"Create site","operationId":"createSite","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"}}}},
    "/sites/{siteId}/pages": {"get":{"tags":["Sites"],"summary":"List site pages","operationId":"listPages","parameters":[{"$ref":"#/components/parameters/SiteId"}],"responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Sites"],"summary":"Create page draft","operationId":"createPage","parameters":[{"$ref":"#/components/parameters/SiteId"}],"responses":{"201":{"$ref":"#/components/responses/ItemResponse"}}}},
    "/pages/{pageId}/publish": {"post":{"tags":["Sites"],"summary":"Publish immutable page revision","operationId":"publishPage","parameters":[{"name":"pageId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/sites/{siteId}/domains": {"get":{"tags":["Sites"],"summary":"List domains","operationId":"listDomains","parameters":[{"$ref":"#/components/parameters/SiteId"}],"responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Sites"],"summary":"Request domain verification","operationId":"createDomain","parameters":[{"$ref":"#/components/parameters/SiteId"}],"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/schools": {"post":{"tags":["Schools"],"summary":"Create school profile","operationId":"createSchool","requestBody":{"$ref":"#/components/requestBodies/JsonBody"},"responses":{"201":{"$ref":"#/components/responses/ItemResponse"}}}},
    "/schools/{schoolId}/academic-years": {"get":{"tags":["Schools"],"summary":"List academic years","operationId":"listAcademicYears","parameters":[{"$ref":"#/components/parameters/SchoolId"}],"responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Schools"],"summary":"Create academic year","operationId":"createAcademicYear","parameters":[{"$ref":"#/components/parameters/SchoolId"}],"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/schools/{schoolId}/classes": {"get":{"tags":["Schools"],"summary":"List classes","operationId":"listClasses","parameters":[{"$ref":"#/components/parameters/SchoolId"}],"responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Schools"],"summary":"Create class","operationId":"createClass","parameters":[{"$ref":"#/components/parameters/SchoolId"}],"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/schools/{schoolId}/students": {"get":{"tags":["Schools"],"summary":"List masked students","operationId":"listStudents","parameters":[{"$ref":"#/components/parameters/SchoolId"}],"responses":{"200":{"$ref":"#/components/responses/ListResponse"}}}},
    "/enrollments": {"get":{"tags":["Enrollment"],"summary":"List enrollments","operationId":"listEnrollments","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Enrollment"],"summary":"Create enrollment","operationId":"createEnrollment","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/enrollments/{enrollmentId}/transfer": {"post":{"tags":["Enrollment"],"summary":"Transfer enrollment with history","operationId":"transferEnrollment","parameters":[{"name":"enrollmentId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/attendance/session-batches": {"post":{"tags":["Attendance"],"summary":"Submit teacher attendance batch","operationId":"submitAttendanceBatch","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"202":{"$ref":"#/components/responses/ItemResponse"},"403":{"$ref":"#/components/responses/Forbidden"}}}},
    "/attendance/records": {"get":{"tags":["Attendance"],"summary":"List attendance records","operationId":"listAttendanceRecords","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}}},
    "/attendance/records/{recordId}/confirm": {"post":{"tags":["Attendance"],"summary":"Confirm attendance revision","operationId":"confirmAttendance","parameters":[{"name":"recordId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"403":{"$ref":"#/components/responses/Forbidden"}}}},
    "/devices/{deviceId}/events": {"post":{"tags":["Attendance"],"summary":"Ingest deduplicated device event","operationId":"ingestDeviceEvent","parameters":[{"name":"deviceId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"202":{"description":"Accepted or deduplicated"},"401":{"$ref":"#/components/responses/Unauthorized"}}}},
    "/notification-rules": {"get":{"tags":["Notifications"],"summary":"List notification rules","operationId":"listNotificationRules","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Notifications"],"summary":"Create notification rule","operationId":"createNotificationRule","responses":{"201":{"$ref":"#/components/responses/ItemResponse"}}}},
    "/templates": {"get":{"tags":["Notifications"],"summary":"List message templates","operationId":"listTemplates","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}},"post":{"tags":["Notifications"],"summary":"Create versioned template","operationId":"createTemplate","responses":{"201":{"$ref":"#/components/responses/ItemResponse"}}}},
    "/message-jobs": {"get":{"tags":["Notifications"],"summary":"List delivery jobs","operationId":"listMessageJobs","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}}},
    "/integrations/providers": {"get":{"tags":["Integrations"],"summary":"List provider capabilities","operationId":"listProviders","responses":{"200":{"$ref":"#/components/responses/ListResponse"}}}},
    "/integrations/{kind}/connections": {"post":{"tags":["Integrations"],"summary":"Create provider connection","operationId":"createProviderConnection","parameters":[{"name":"kind","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"201":{"$ref":"#/components/responses/ItemResponse"},"422":{"$ref":"#/components/responses/ValidationError"}}}},
    "/integrations/{integrationId}/health": {"get":{"tags":["Integrations"],"summary":"Get provider health","operationId":"getIntegrationHealth","parameters":[{"name":"integrationId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"$ref":"#/components/responses/ItemResponse"},"503":{"$ref":"#/components/responses/ServiceUnavailable"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}},
    "parameters": {
      "TenantId":{"name":"tenantId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "RoleId":{"name":"roleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "OrgUnitId":{"name":"orgUnitId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "UserId":{"name":"userId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "SubscriptionId":{"name":"subscriptionId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "InvoiceId":{"name":"invoiceId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "SiteId":{"name":"siteId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "SchoolId":{"name":"schoolId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":128}}
    },
    "requestBodies": {"JsonBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}}},
    "schemas": {
      "Health":{"type":"object","required":["status"],"properties":{"status":{"type":"string","enum":["ok","degraded"]},"version":{"type":"string"}}},
      "Envelope":{"type":"object","properties":{"data":{},"meta":{"type":"object","properties":{"requestId":{"type":"string"},"version":{"type":"string"}}}}},
      "Error":{"type":"object","properties":{"error":{"type":"object","required":["code","message"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"details":{"type":"array","items":{}}}},"meta":{"type":"object"}}}
    },
    "responses": {
      "ItemResponse":{"description":"Item response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},
      "ListResponse":{"description":"Cursor-paginated list","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"}}}},
      "Unauthorized":{"description":"Authentication failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
      "Forbidden":{"description":"Scope, permission or entitlement denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
      "NotFound":{"description":"Resource unavailable without existence disclosure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
      "Conflict":{"description":"Version, uniqueness or idempotency conflict","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
      "ValidationError":{"description":"Semantic validation failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
      "TooManyRequests":{"description":"Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
      "ServiceUnavailable":{"description":"Dependency unavailable","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}
    }
  },
  "security": [{"bearerAuth":[]}]
}
