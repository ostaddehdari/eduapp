{
  "schema_version": "1.0",
  "workflow_id": "S01-W04-T02",
  "version": "1.0.0",
  "status": "accepted_operating_model",
  "approved_at": "2026-11-24",
  "requirement_ids": ["SEC-002"],
  "source_contract": {
    "path": "docs/contracts/S01-W04.json",
    "contract_id": "S01-W04",
    "version": "1.0.0"
  },
  "safety_boundary": {
    "planning_records_complete": true,
    "external_legal_decisions_complete": false,
    "provider_selection_complete": false,
    "production_activation_permitted": false,
    "default": "deny",
    "stable_error": "PROVIDER_ACTIVATION_GATES_INCOMPLETE",
    "notice": "This workflow records review state; it does not replace legal advice, signed contracts, approved budgets or production approval."
  },
  "state_model": {
    "initial_state": "evidence_collecting",
    "terminal_states": ["activated", "revoked"],
    "states": [
      "evidence_collecting",
      "ready_for_review",
      "in_review",
      "approved",
      "activation_requested",
      "activated",
      "suspended",
      "revoked"
    ],
    "transitions": [
      {
        "from": "evidence_collecting",
        "to": "ready_for_review",
        "actor": "decision_owner",
        "gate": "all_required_evidence_refs_present"
      },
      {
        "from": "ready_for_review",
        "to": "in_review",
        "actor": "configured_approver",
        "gate": "evidence_manifest_integrity_valid"
      },
      {
        "from": "in_review",
        "to": "approved",
        "actor": "workflow_engine",
        "gate": "all_configured_approvals_recorded"
      },
      {
        "from": "approved",
        "to": "activation_requested",
        "actor": "decision_owner",
        "gate": "external_value_and_activation_gates_complete"
      },
      {
        "from": "activation_requested",
        "to": "activated",
        "actor": "platform_owner",
        "gate": "separate_production_change_approved"
      },
      {
        "from": "approved",
        "to": "evidence_collecting",
        "actor": "configured_approver",
        "gate": "material_evidence_changed"
      },
      {
        "from": "activated",
        "to": "suspended",
        "actor": "security_or_legal_owner",
        "gate": "incident_or_contract_risk_recorded"
      },
      {
        "from": "suspended",
        "to": "activation_requested",
        "actor": "decision_owner",
        "gate": "remediation_evidence_approved"
      },
      {
        "from": "evidence_collecting",
        "to": "revoked",
        "actor": "decision_owner",
        "gate": "decision_cancelled_with_reason"
      },
      {
        "from": "approved",
        "to": "revoked",
        "actor": "decision_owner",
        "gate": "decision_cancelled_with_reason"
      },
      {
        "from": "suspended",
        "to": "revoked",
        "actor": "decision_owner",
        "gate": "contract_or_legal_basis_ended"
      }
    ]
  },
  "evidence_policy": {
    "storage": "approved_private_evidence_store",
    "repository_content": "metadata_and_hash_only",
    "required_metadata": [
      "evidence_type",
      "opaque_reference",
      "sha256",
      "issued_at",
      "expires_at",
      "submitted_by",
      "classification"
    ],
    "forbidden_content": [
      "raw_contract_document",
      "child_pii",
      "provider_secret",
      "bank_credential",
      "raw_biometric_template"
    ],
    "append_only_history": true,
    "replacement_requires_new_version": true,
    "expired_evidence_blocks_activation": true
  },
  "approval_policy": {
    "all_configured_approvers_required": true,
    "minimum_distinct_approver_roles": 3,
    "approval_record_fields": [
      "decision_id",
      "decision_version",
      "approver_role",
      "actor_id",
      "evidence_manifest_hash",
      "approved_at",
      "expires_at",
      "comment_ref"
    ],
    "approval_is_version_bound": true,
    "evidence_change_invalidates_approvals": true,
    "role_impersonation_forbidden": true,
    "decision_owner_cannot_supply_other_approvals": true
  },
  "operational_steps": [
    {
      "order": 1,
      "id": "open_case",
      "owner": "decision_owner",
      "output": "versioned_case_in_evidence_collecting"
    },
    {
      "order": 2,
      "id": "attach_evidence_manifest",
      "owner": "decision_owner",
      "output": "metadata_and_hash_refs_only"
    },
    {
      "order": 3,
      "id": "validate_completeness",
      "owner": "workflow_engine",
      "output": "ready_for_review_or_missing_evidence_codes"
    },
    {
      "order": 4,
      "id": "collect_distinct_approvals",
      "owner": "configured_approvers",
      "output": "version_bound_approval_records"
    },
    {
      "order": 5,
      "id": "record_external_value",
      "owner": "decision_owner",
      "output": "legal_or_provider_value_with_effective_date"
    },
    {
      "order": 6,
      "id": "evaluate_activation_gates",
      "owner": "workflow_engine",
      "output": "deny_reasons_or_activation_eligible"
    },
    {
      "order": 7,
      "id": "request_separate_production_change",
      "owner": "platform_owner",
      "output": "reviewed_change_reference"
    },
    {
      "order": 8,
      "id": "activate_and_monitor",
      "owner": "platform_owner",
      "output": "audited_activation_receipt"
    }
  ],
